<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>CelesteMovementHelper</AssemblyName>
    <RootNamespace>Celeste.Mod.CelesteMovementHelper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <CelestePrefix Condition="'$(CelestePrefix)' == ''">D:\Games\Celeste</CelestePrefix>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference Private="false" />
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="$(CelestePrefix)\Celeste.dll" />
    <Reference Include="$(CelestePrefix)\MMHOOK_Celeste.dll" />
    <Reference Include="$(CelestePrefix)\FNA.dll" />
    <Reference Include="$(CelestePrefix)\MonoMod.RuntimeDetour.dll" />
    <Reference Include="$(CelestePrefix)\MonoMod.Utils.dll" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Data\logic.json" LogicalName="CMH.logic.json" />
    <EmbeddedResource Include="..\Data\techniques.json" LogicalName="CMH.techniques.json" Condition="Exists('..\Data\techniques.json')" />
  </ItemGroup>

  <Target Name="CopyToBin" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll;$(OutputPath)$(AssemblyName).pdb" DestinationFolder="..\bin" />
  </Target>
</Project>
